{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AvengerReviewResult",
  "type": "object",
  "required": ["verdict", "issues", "summary"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED"]
    },
    "issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {"type": "string"}
  }
}
