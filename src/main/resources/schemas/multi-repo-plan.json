{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultiRepoImplementationPlan",
  "type": "object",
  "required": ["requirement", "multiRepo", "projects"],
  "properties": {
    "requirement": {"type": "string", "minLength": 1},
    "multiRepo":   {"type": "boolean"},
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["projectId", "status"],
        "properties": {
          "projectId":  {"type": "string", "minLength": 1},
          "status":     {"type": "string", "enum": ["OK", "FAILED"]},
          "plan":       {"type": "object"},
          "error":      {"type": "string"}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
