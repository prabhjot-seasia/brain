{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ImplementationPlan",
  "type": "object",
  "required": ["requirement", "affectedFiles", "steps"],
  "properties": {
    "requirement": {"type": "string", "minLength": 1},
    "understanding": {
      "type": "object",
      "properties": {
        "why":   {"type": "string"},
        "what":  {"type": "string"},
        "where": {"type": "string"},
        "how":   {"type": "string"}
      }
    },
    "affectedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path":       {"type": "string", "minLength": 1},
          "reason":     {"type": "string"},
          "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "description"],
        "properties": {
          "order":       {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1},
          "convention":  {"type": "string"},
          "files":       {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity"],
        "properties": {
          "description": {"type": "string"},
          "severity":    {"type": "string", "enum": ["low", "medium", "high"]},
          "files":       {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "conventionsApplied": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule":   {"type": "string"},
          "source": {"type": "string"}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
