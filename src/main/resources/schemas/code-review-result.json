{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeReviewResult",
  "type": "object",
  "required": ["verdict", "issues", "summary"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "pass", "fail"]
    },
    "issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {"type": "string"}
  }
}
